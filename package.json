{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "lint": "pnpm dlx oxlint@1.89.0 app lib tests",
    "format": "pnpm dlx oxfmt@0.74.0 --write app lib tests",
    "format:check": "pnpm dlx oxfmt@0.74.0 --check app lib tests",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "db:migrate": "node --experimental-strip-types scripts/migrate-state.ts && node --conditions=react-server --experimental-strip-types scripts/migrate-auth.ts",
    "db:import-sqlite": "node --conditions=react-server --experimental-strip-types scripts/import-sqlite.ts",
    "test:postgres": "node --experimental-strip-types --test tests/postgres-state.integration.test.ts tests/sqlite-import.integration.test.ts",
    "test:http": "node --conditions=react-server --experimental-strip-types --test tests/http-flow.integration.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vercel/analytics": "2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "pg": "8.23.1",
    "better-auth": "1.7.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "@types/pg": "^8.15.5"
  }
}
