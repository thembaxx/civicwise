# Set the same shared PostgreSQL URL on every instance. Use provider-recommended
# verified TLS settings for remote databases. Never commit the real URL.
DATABASE_URL=

# Generate a random secret of at least 32 characters. Keep it server-side.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Authorized Google redirect: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local SQLite development only. Vercel production rejects every SQLite path.
CIVICWISE_DATABASE_PATH=.data/civicwise.sqlite
# Fictional local demo writes only; disabled with DATABASE_URL or on Vercel.
CIVICWISE_DEMO_DATA=false
